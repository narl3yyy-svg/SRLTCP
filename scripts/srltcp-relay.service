# systemd unit for the SRLTCP internet relay.
#   sudo useradd --system --create-home --home-dir /var/lib/srltcp-relay srltcp
#   sudo -u srltcp git clone https://github.com/narl3yyy-svg/SRLTCP.git /var/lib/srltcp-relay/SRLTCP
#   sudo -u srltcp python3 -m venv /var/lib/srltcp-relay/venv
#   sudo -u srltcp /var/lib/srltcp-relay/venv/bin/pip install -e /var/lib/srltcp-relay/SRLTCP
#   sudo cp scripts/srltcp-relay.service /etc/systemd/system/ && edit --public-host below
#   sudo systemctl enable --now srltcp-relay && journalctl -u srltcp-relay   # shows the relay code
[Unit]
Description=SRLTCP internet relay
After=network-online.target
Wants=network-online.target

[Service]
User=srltcp
ExecStart=/var/lib/srltcp-relay/venv/bin/srltcp relay --port 7827 --public-host YOUR.SERVER.IP --data-dir /var/lib/srltcp-relay/keys
Restart=always
RestartSec=3
# Hardening: the relay needs only its key directory and the network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/srltcp-relay/keys
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
# To use port 443 instead of 7827, add: AmbientCapabilities=CAP_NET_BIND_SERVICE
#   and CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
