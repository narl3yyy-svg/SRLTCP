{
  "name": "srltcp-desktop",
  "productName": "SRLTCP",
  "version": "0.17.12",
  "description": "SRLTCP desktop app: peer-to-peer, quantum-safe messenger (tray / menu bar app)",
  "main": "main.js",
  "desktopName": "srltcp-desktop.desktop",
  "author": "SRLTCP Contributors",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/narl3yyy-svg/SRLTCP",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:linux": "electron-builder --linux deb --x64"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.srltcp.desktop",
    "productName": "SRLTCP",
    "copyright": "SRLTCP Contributors — GPL v3",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "backend/win-x64",
          "to": "backend"
        }
      ],
      "artifactName": "SRLTCP-${version}-windows-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SRLTCP",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.social-networking",
      "identity": null,
      "minimumSystemVersion": "12.0",
      "extraResources": [
        {
          "from": "backend/mac-arm64",
          "to": "backend"
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "SRLTCP uses the camera for video calls with your contacts.",
        "NSMicrophoneUsageDescription": "SRLTCP uses the microphone for calls with your contacts.",
        "NSLocalNetworkUsageDescription": "SRLTCP connects directly to your contacts on your Wi-Fi or VPN."
      }
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Network",
      "maintainer": "narl3yyy-svg <283486160+narl3yyy-svg@users.noreply.github.com>",
      "vendor": "SRLTCP Contributors",
      "synopsis": "Peer-to-peer, quantum-safe messenger and file transfer",
      "description": "SRLTCP: fast, secure peer-to-peer messaging, calls and file transfer over Serial (USB) and TCP/IP. Bundles its own Python and Tor.",
      "desktop": {
        "entry": {
          "Name": "SRLTCP",
          "GenericName": "Secure Messenger",
          "Keywords": "chat;messenger;p2p;file transfer;serial;tor;"
        }
      },
      "extraResources": [
        {
          "from": "backend/linux-x64",
          "to": "backend"
        }
      ],
      "artifactName": "SRLTCP-${version}-linux-amd64.${ext}",
      "syncDesktopName": true
    },
    "publish": null,
    "deb": {
      "packageName": "srltcp",
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2",
        "libgbm1"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narl3yyy-svg/SRLTCP.git"
  }
}
