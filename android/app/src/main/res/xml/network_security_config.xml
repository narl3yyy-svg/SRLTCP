<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <!-- No trust anchors: the local server's self-signed certificate is
             accepted only by the SHA-256 pin in MainActivity.onReceivedSslError,
             so a user-installed CA cannot stand in for it. -->
        <trust-anchors />
    </domain-config>
</network-security-config>